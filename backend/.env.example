# 複製成 .env 並填入真實值。切勿把 .env commit 進 repo。

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://photoflow:photoflow@localhost:5432/photoflow

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Meta (Threads / Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/auth/meta/callback

# --- X (Twitter) API v2 ---
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# --- Google Drive ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# --- Claude AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEEP=claude-opus-4-8
ANTHROPIC_MODEL_FAST=claude-sonnet-4-6

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
